{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [],
    "steps": [
      {
        "name": "scope",
        "label": "What to discover",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.TextBlock",
            "options": {
              "text": "CosmosProof finds every Azure Databricks workspace and ADLS Gen2 account in the scope you choose. You then decide in the CosmosProof app what to analyze; development and POC resources start unselected. CosmosProof only reads."
            }
          },
          {
            "name": "scopeType",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Discover by",
            "defaultValue": "Subscriptions",
            "constraints": {
              "allowedValues": [
                { "label": "Subscriptions", "value": "subscriptions" },
                { "label": "Management group", "value": "managementGroups" }
              ],
              "required": true
            }
          },
          {
            "name": "scopeIds",
            "type": "Microsoft.Common.TextBox",
            "label": "Subscription IDs or management group ID",
            "toolTip": "One or more IDs separated by commas. The CosmosProof identity will need Reader on them.",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[A-Za-z0-9-_.()]{1,90}(,[A-Za-z0-9-_.()]{1,90}){0,49}$",
                  "message": "IDs separated by commas, without spaces."
                }
              ]
            }
          }
        ]
      },
      {
        "name": "schedule",
        "label": "Schedule",
        "elements": [
          {
            "name": "windowDays",
            "type": "Microsoft.Common.Slider",
            "label": "Days without a read that make data unused",
            "min": 7,
            "max": 395,
            "defaultValue": 90,
            "showStepMarkers": false,
            "constraints": { "required": true }
          },
          {
            "name": "accessTrackingSince",
            "type": "Microsoft.Common.TextBox",
            "label": "Last access tracking enabled on (optional)",
            "toolTip": "The date last access time tracking was enabled on your ADLS accounts, as yyyy-mm-dd. Leave empty if it is off.",
            "defaultValue": "",
            "constraints": {
              "required": false,
              "validations": [
                { "regex": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "message": "Leave empty or use yyyy-mm-dd." }
              ]
            }
          },
          {
            "name": "cron",
            "type": "Microsoft.Common.TextBox",
            "label": "Daily audit time (cron, UTC)",
            "defaultValue": "0 6 * * *",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20}$",
                  "message": "Five cron fields, for example 0 6 * * *."
                }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "scopeType": "[steps('scope').scopeType]",
      "scopeIds": "[steps('scope').scopeIds]",
      "windowDays": "[steps('schedule').windowDays]",
      "accessTrackingSince": "[steps('schedule').accessTrackingSince]",
      "cron": "[steps('schedule').cron]"
    }
  }
}
