{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [],
    "steps": [
      {
        "name": "databricks",
        "label": "Azure Databricks",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.TextBlock",
            "options": {
              "text": "CosmosProof only reads. After deployment you give its managed identity read access to Unity Catalog metadata and to the storage you choose; the deployment outputs show how."
            }
          },
          {
            "name": "databricksHost",
            "type": "Microsoft.Common.TextBox",
            "label": "Workspace host",
            "toolTip": "For example adb-1234567890123456.7.azuredatabricks.net, without https://.",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^adb-[0-9]{1,20}\\.[0-9]{1,3}\\.azuredatabricks\\.net$",
                  "message": "Use the workspace host, such as adb-1234567890123456.7.azuredatabricks.net."
                }
              ]
            }
          },
          {
            "name": "warehouseId",
            "type": "Microsoft.Common.TextBox",
            "label": "SQL warehouse ID",
            "toolTip": "The ID in the warehouse's connection details (HTTP path /sql/1.0/warehouses/<id>).",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[a-f0-9]{16}$",
                  "message": "A SQL warehouse ID has 16 lowercase hexadecimal characters."
                }
              ]
            }
          }
        ]
      },
      {
        "name": "storage",
        "label": "ADLS Gen2",
        "elements": [
          {
            "name": "storageAccountName",
            "type": "Microsoft.Common.TextBox",
            "label": "Storage account to scan",
            "toolTip": "The ADLS Gen2 account that holds the lake.",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[a-z0-9]{3,24}$",
                  "message": "3 to 24 lowercase letters and numbers."
                }
              ]
            }
          },
          {
            "name": "storageContainer",
            "type": "Microsoft.Common.TextBox",
            "label": "Container to scan",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[a-z0-9](?!.*--)[a-z0-9-]{1,61}[a-z0-9]$",
                  "message": "3 to 63 lowercase letters, numbers and single hyphens."
                }
              ]
            }
          },
          {
            "name": "accessTrackingSince",
            "type": "Microsoft.Common.TextBox",
            "label": "Last access tracking enabled on (optional)",
            "toolTip": "The date last access time tracking was enabled on the account, as yyyy-mm-dd. Leave empty if it is off; the grants script enables it.",
            "defaultValue": "",
            "constraints": {
              "required": false,
              "validations": [
                {
                  "regex": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "message": "Leave empty or use yyyy-mm-dd."
                }
              ]
            }
          }
        ]
      },
      {
        "name": "schedule",
        "label": "Schedule",
        "elements": [
          {
            "name": "windowDays",
            "type": "Microsoft.Common.Slider",
            "label": "Days without a read that make data unused",
            "min": 7,
            "max": 395,
            "defaultValue": 90,
            "showStepMarkers": false,
            "constraints": {
              "required": true
            }
          },
          {
            "name": "cron",
            "type": "Microsoft.Common.TextBox",
            "label": "Daily scan time (cron, UTC)",
            "defaultValue": "0 6 * * *",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20} [0-9*/,-]{1,20}$",
                  "message": "Five cron fields, for example 0 6 * * *."
                }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "databricksHost": "[steps('databricks').databricksHost]",
      "warehouseId": "[steps('databricks').warehouseId]",
      "storageAccountName": "[steps('storage').storageAccountName]",
      "storageContainer": "[steps('storage').storageContainer]",
      "accessTrackingSince": "[steps('storage').accessTrackingSince]",
      "windowDays": "[steps('schedule').windowDays]",
      "cron": "[steps('schedule').cron]"
    }
  }
}
